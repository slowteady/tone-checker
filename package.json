{
  "name": "tone-checker",
  "private": true,
  "scripts": {
    "dev": "granite dev",
    "dev:local": "DOTENV_CONFIG_PATH=.env.local granite dev",
    "build": "granite build",
    "build:dev": "granite build --dev",
    "test": "jest --passWithNoTests",
    "test:edge": "cd supabase/functions/analyze-tone/__tests__ && deno test --allow-net --allow-env --config deno.json integration.test.ts",
    "test:edge:watch": "cd supabase/functions/analyze-tone/__tests__ && deno test --allow-net --allow-env --config deno.json --watch integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf .granite node_modules"
  },
  "dependencies": {
    "@apps-in-toss/framework": "^1.8.0",
    "@granite-js/native": "0.1.34",
    "@granite-js/plugin-env": "^0.1.34",
    "@granite-js/plugin-sentry": "^0.1.34",
    "@granite-js/react-native": "0.1.34",
    "@sentry/react-native": "^7.11.0",
    "@supabase/supabase-js": "^2.91.1",
    "@tanstack/react-query": "^5.90.20",
    "@toss/tds-colors": "0.1.0",
    "@toss/tds-react-native": "1.3.8",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@eslint/js": "^9.17.0",
    "@granite-js/plugin-hermes": "0.1.34",
    "@granite-js/plugin-router": "0.1.34",
    "@testing-library/react-native": "^12.9.0",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.3",
    "babel-preset-granite": "0.1.34",
    "dotenv": "^17.2.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^29.7.0",
    "prettier": "3.4.2",
    "react-test-renderer": "18.2.0",
    "supabase": "^2.72.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  }
}
